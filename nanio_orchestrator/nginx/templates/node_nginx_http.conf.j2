# Generated by nanio-orchestrator for node: {{ member_address }}
# Pool: {{ pool_name }} (http, read-only file serving)
server {
    listen {{ listen_port }};
    server_name _;

    root {{ data_dir }};
    autoindex off;
    expires 30d;
    add_header Cache-Control "public, immutable";
    add_header Accept-Ranges bytes;

    gzip_static on;
    gzip_types text/plain application/json application/javascript text/css;

    # nanio keeps object metadata and unfinished multipart uploads in hidden
    # directories next to the objects. They are not objects: never serve them.
    location ~ /\.nanio {
        return 404;
    }

    location / {
        limit_except GET HEAD { deny all; }
        try_files $uri =404;
    }
}

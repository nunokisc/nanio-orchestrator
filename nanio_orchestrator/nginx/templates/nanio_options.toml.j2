# Generated by nanio-orchestrator for node: {{ member_address }}
# Pool: {{ pool_name }}
# Contains the S3 secret key: keep it readable by the nanio user only (chmod 600).
[server]
data_dir = "{{ data_dir }}"
host     = "{{ nanio_host }}"
port     = {{ nanio_port }}
region   = "{{ nanio_region }}"

{% if access_key and secret_key %}
[[users]]
access_key = "{{ access_key }}"
secret_key = "{{ secret_key }}"
{% else %}
# nanio refuses to start without credentials. Fill these in with the same
# credentials stored for pool "{{ pool_name }}" in the orchestrator.
# [[users]]
# access_key = "CHANGE_ME"
# secret_key = "CHANGE_ME"
{% endif %}

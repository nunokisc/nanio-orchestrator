# Generated by nanio-orchestrator for node: {{ member_address }}
[Unit]
Description=nanio S3-compatible storage ({{ pool_name }})
After=network-online.target
Wants=network-online.target
# Never start on an unmounted data directory: nanio would serve an empty tree.
RequiresMountsFor={{ data_dir }}

[Service]
Type=simple
User=nanio
Group=nanio
ExecStart={{ nanio_bin }} serve --options /etc/nanio/options.toml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths={{ data_dir }}

[Install]
WantedBy=multi-user.target

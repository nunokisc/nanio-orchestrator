# Generated by nanio-orchestrator for node: {{ member_address }}
# Pool: {{ pool_name }} (nginx in front of a local nanio)
upstream local-nanio {
    server 127.0.0.1:{{ nanio_port }};
    keepalive 32;
}

server {
    listen {{ listen_port }};
    server_name _;

    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering         off;

    location / {
        proxy_pass         http://local-nanio;
        proxy_http_version 1.1;
        # Forward Host exactly as received: it is part of the SigV4 signature.
        proxy_set_header   Host       $http_host;
        proxy_set_header   Connection "";
    }
}

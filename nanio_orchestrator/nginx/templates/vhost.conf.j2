# managed by nanio-orchestrator
# vhost_id:{{ vhost.id }} name:{{ vhost.server_name }} updated:{{ updated }}
server {
{% if vhost.ssl %}
    listen {{ vhost.listen_port }} ssl;
    http2  on;
{% else %}
    listen {{ vhost.listen_port }};
{% endif %}
    server_name {{ vhost.server_name }};
{% if extra_blocks_top %}
{% for block in extra_blocks_top %}

    {{ block.content | indent(4) }}
{% endfor %}
{% endif %}
{% if ip_rule_mode == 'allow' and ip_rule_ips %}

    # IP allowlist — only these addresses may access this vhost
{% for ip in ip_rule_ips %}
    allow {{ ip }};
{% endfor %}
    deny all;
{% elif ip_rule_mode == 'deny' and ip_rule_ips %}

    # IP denylist — these addresses are blocked
{% for ip in ip_rule_ips %}
    deny {{ ip }};
{% endfor %}
{% endif %}
{% if vhost.ssl and vhost.ssl_cert_path %}

    ssl_certificate     {{ vhost.ssl_cert_path }};
    ssl_certificate_key {{ vhost.ssl_key_path }};
{% endif %}
{% if extra_blocks_ssl %}
{% for block in extra_blocks_ssl %}

    {{ block.content | indent(4) }}
{% endfor %}
{% endif %}

    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering         off;
{% if vhost.extra_directives %}

    {{ vhost.extra_directives }}
{% endif %}
{% if extra_blocks_proxy %}
{% for block in extra_blocks_proxy %}

    {{ block.content | indent(4) }}
{% endfor %}
{% endif %}
{% for route in routes %}
{% if route.enabled %}

{% if route.migration_dst_pool_name %}
    # route_id:{{ route.id }} prefix:{{ route.path_prefix }} migration_src:{{ route.pool_name }} migration_dst:{{ route.migration_dst_pool_name }} [LIVE MIGRATION → {{ route.migration_dst_pool_name }}]
    location {{ route.path_prefix }} {
        # Live migration split routing — the destination pool ({{ route.migration_dst_pool_name }}) is authoritative:
        #   writes            → destination only (the source receives no new data)
        #   reads (GET/HEAD)  → destination, falling back to the source ({{ route.pool_name }}) on 404
        #   DELETE            → destination, mirrored to the source so the fallback cannot resurrect it
        mirror /__nanio_mig_{{ route.id }}_delete;
        mirror_request_body off;
        proxy_intercept_errors on;
        error_page 404 = @nanio_mig_{{ route.id }};
        proxy_pass         http://{{ route.migration_dst_pool_name }};
{% else %}
    # route_id:{{ route.id }} prefix:{{ route.path_prefix }}
    location {{ route.path_prefix }} {
{% if route.key_prefix %}
        rewrite ^{{ route.path_prefix }}(.*)$ /{{ route.key_prefix }}$1 break;
{% endif %}
        proxy_pass         http://{{ route.pool_name }};
{% endif %}
        proxy_http_version 1.1;
        proxy_set_header   Host              $http_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Connection        "";
{% if route.extra_directives %}
        {{ route.extra_directives }}
{% endif %}
    }
{% endif %}
{% endfor %}
{% for route in routes %}
{% if route.enabled and route.migration_dst_pool_name %}

    # Source fallback for reads during live migration route_id:{{ route.id }}
    location @nanio_mig_{{ route.id }} {
        if ($request_method !~ ^(GET|HEAD)$) { return 404; }
        proxy_pass         http://{{ route.pool_name }};
        proxy_http_version 1.1;
        proxy_set_header   Host              $http_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Connection        "";
    }

    # DELETE mirror to the source during live migration route_id:{{ route.id }}
    location = /__nanio_mig_{{ route.id }}_delete {
        internal;
        if ($request_method != DELETE) { return 204; }
        proxy_pass         http://{{ route.pool_name }}$request_uri;
        proxy_pass_request_body off;
        proxy_http_version 1.1;
        proxy_set_header   Host              $http_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   Connection        "";
    }
{% endif %}
{% endfor %}
{% if extra_blocks_end %}
{% for block in extra_blocks_end %}

    {{ block.content | indent(4) }}
{% endfor %}
{% endif %}
}
